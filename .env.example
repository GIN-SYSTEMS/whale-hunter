# =============================================================================
# Whale Hunter v11.0 — SOVEREIGN  ·  Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to `.env` (same directory) and fill in your credentials.
#
# SECURITY NOTES
#   * The `.env` file is git-ignored by default — DO NOT remove that rule.
#   * Sensitive values (WSS_URL, TELEGRAM_BOT_TOKEN) are encrypted to ENC:...
#     ciphertext at rest by the SecurityVault when you save via the TUI.
#   * The vault key lives at:
#       Linux/macOS  : $XDG_CONFIG_HOME/whale-hunter/vault.key  (0600)
#       Windows      : %APPDATA%\whale-hunter\vault.key
#     Treat it like an SSH private key — never share it, never commit it.
#
# QUICK START
#   1.  cp .env.example .env
#   2.  python main.py --setup          # interactive TUI wizard (recommended)
#       — OR —
#       fill in the placeholders below by hand.
# =============================================================================


# ──[ 1. RPC / WebSocket Endpoint ]────────────────────────────────────────────
# Required for live mode. Leave blank to launch the simulator instead.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROVIDER-AGNOSTIC: Whale Hunter is NOT locked to any single vendor.    │
# │  Paste whichever endpoint your provider hands you — WSS or HTTPS — and  │
# │  the system handles the rest.                                           │
# └─────────────────────────────────────────────────────────────────────────┘
#
# WHY THE SCHEME MATTERS
#   The mempool ingestor needs a *streaming* connection, so the actual
#   transport is always WSS (WebSocket Secure). However, every major
#   provider exposes the SAME endpoint under both schemes:
#
#     HTTPS  :  https://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>
#     WSS    :  wss://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>
#
#   Most provider dashboards copy the HTTPS form by default. That is fine —
#   the setup wizard auto-rewrites the scheme:
#
#     https://...  →  wss://...
#     http://...   →  ws://...
#
#   You can paste either form here. The transport will negotiate WSS at
#   connection time. No manual scheme conversion required.
#
# SUPPORTED PROVIDERS (every one of these works out of the box)
#   Alchemy     :  wss://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>
#   Infura      :  wss://mainnet.infura.io/ws/v3/<YOUR_KEY>
#   QuickNode   :  wss://<endpoint>.quiknode.pro/<YOUR_TOKEN>/
#   Ankr        :  wss://rpc.ankr.com/eth/ws/<YOUR_KEY>
#   Chainstack  :  wss://<endpoint>.chainstacklabs.com/<YOUR_KEY>
#   BlastAPI    :  wss://eth-mainnet.blastapi.io/<YOUR_KEY>
#   GetBlock    :  wss://eth.getblock.io/<YOUR_KEY>/mainnet/
#   LlamaNodes  :  wss://eth.llamarpc.com                  (free, no key)
#   PublicNode  :  wss://ethereum.publicnode.com           (free, no key)
#   Self-host   :  wss://your-node.example.com:8546        (Geth, Erigon, Nethermind, Reth)
#
# OR paste an HTTPS form — it will be rewritten:
#   https://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>        ← also valid
#   https://mainnet.infura.io/v3/<YOUR_KEY>                ← also valid
WSS_URL=YOUR_WSS_OR_HTTPS_URL_HERE

# Subscription method:
#   auto      → autodetect (alchemy.com → alchemy_pendingTransactions; else
#               newPendingTransactions). Recommended.
#   alchemy   → force alchemy_pendingTransactions (only works on Alchemy).
#   standard  → force newPendingTransactions (works on every JSON-RPC node;
#               Whale Hunter does an eth_getTransactionByHash follow-up over
#               the same WSS to fetch the body).
WSS_SUBSCRIPTION_METHOD=auto

# Fallback URLs (CSV). The transport rotates to the next entry every time
# the primary fails an auth/network/timeout check — no manual restart
# needed when one provider has an outage.
#   Example:
#     WSS_FALLBACK_URLS=wss://mainnet.infura.io/ws/v3/KEY1,wss://eth.llamarpc.com
WSS_FALLBACK_URLS=


# ──[ 2. Additional Chains (optional) ]───────────────────────────────────────
# Each CHAIN_<NAME>_URL var spawns one ingestor process. Workers run hunters
# against every chain in parallel. Leave blank to disable a chain entirely.
#
# CHAIN_ETH_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# CHAIN_BASE_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# CHAIN_ARB_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# CHAIN_BSC_URL=wss://bsc-dataseed.binance.org/ws    # public node, no key
WSS_BASE_URL=
WSS_SOL_URL=
WSS_BACKUP_URL=


# ──[ 3. Telegram Alerting (optional) ]───────────────────────────────────────
# Both TOKEN and CHAT_ID must be set for Telegram to actually deliver.
#
#  - Bot Token : create a bot via @BotFather, copy the API token.
#                Shape:  <bot_id>:<35_char_alphanumeric_secret>
#                        (the placeholder below is NOT a real token)
#  - Chat ID   : DM @userinfobot from your account, or use the Telegram API.
#                Personal chats : positive integer  (e.g. YOUR_NUMERIC_ID)
#                Group chats    : negative integer  (e.g. -YOUR_GROUP_ID)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
TELEGRAM_ENABLED=0


# ──[ 4. Active chain label ]──────────────────────────────────────────────────
# Display label shown in the TUI header + used to pick the right block-explorer
# for the InspectionModal "Open in Etherscan" launcher. Recognised values:
#   ETH | BASE | ARB | POLY | BSC | OPT | SOL | BTC | MULTI
CHAIN_TYPE=ETH


# ──[ 5. Simulator Mode ]─────────────────────────────────────────────────────
# 1 = run entirely offline with synthetic transactions (no API key, no network).
# 0 = live ingestion against WSS_URL.
WHALE_SIMULATOR=0


# ──[ 6. Heuristic Thresholds ]───────────────────────────────────────────────
# All adjustable at runtime via the in-TUI Settings modal.
#
# WHALE_THRESHOLD_ETH    : minimum native value to qualify as a "whale" tx
# INSIDER_THRESHOLD_USD  : minimum USD-equivalent for InsiderScanner to fire
# DORMANT_YEARS          : age (in years) before a wallet is "dormant"
# ALERT_SCORE_THRESHOLD  : minimum signal score (0-100) before Telegram fires
WHALE_THRESHOLD_ETH=100
INSIDER_THRESHOLD_USD=500000
DORMANT_YEARS=5
ALERT_SCORE_THRESHOLD=80


# ──[ 7. Pricing oracle (cheap heuristic) ]───────────────────────────────────
# Static ETH price used for USD-value calculations in hunters. Update by hand
# or wire your own oracle into core/intelligence.py.
ETH_PRICE_USD=3000


# ──[ 8. Performance Tuning ]─────────────────────────────────────────────────
# MAX_QUEUE_SIZE   : back-pressure cap on the mempool buffer (drops oldest)
MAX_QUEUE_SIZE=50000


# ──[ 8b. Sovereign Notification Shield ]─────────────────────────────────────
# OS-level desktop notifications (Windows toast / macOS Notification Center
# / Linux libnotify). DISABLED by default — the TUI is your primary feed.
# When enabled, the shield filters AGGRESSIVELY:
#
#   * Fires only for VIP-flagged hits OR transactions >= OS_NOTIFY_MIN_ETH
#   * Throttled to one fire per OS_NOTIFY_THROTTLE_SEC, no matter how busy
#     the mempool gets
#
# Use this when you want a tray ping for tier-1 events while watching
# everything else silently in the TUI.
OS_NOTIFICATIONS_ENABLED=0
OS_NOTIFY_MIN_ETH=100
OS_NOTIFY_THROTTLE_SEC=10


# ──[ 9. Watchlist files (optional, advanced) ]───────────────────────────────
# By convention, `targets.json` next to this .env is auto-loaded as the
# operator watchlist. Override the location with these vars if you keep
# the file elsewhere (useful for multi-environment setups):
#
# VIP_WALLETS=0xabc...,0xdef...   # comma-separated CSV of extra VIP addresses
# VIP_WALLETS_FILE=/path/to/extra-targets.json
#
# Bridge / DEX router watchlist for the OraclePredictor chain-reaction
# detector. Defaults to a curated public set (Uniswap, Stargate, etc.).
# BRIDGE_ADDRESSES=0xrouter1...,0xrouter2...


# ──[ 10. ClickHouse Persistence (advanced, optional) ]───────────────────────
# Disabled by default. Set USE_CLICKHOUSE=1 only if you have a local
# ClickHouse server running on the host below — otherwise the daemon
# silently runs in memory-only mode (no install pain, no warnings).
USE_CLICKHOUSE=0
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=whale_hunter
